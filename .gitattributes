# Keep LF line endings on every platform: Git for Windows would otherwise convert checked-out files to
# CRLF, which breaks shell scripts and config files that are copied into Linux containers.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.ini text eol=lf
Dockerfile text eol=lf
*.gif binary
*.png binary
*.jpg binary
*.pdf binary
