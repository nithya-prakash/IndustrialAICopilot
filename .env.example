# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Postgres ---
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=industrial_copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full async DSN used by the app; compose from the vars above by default.
DATABASE_URL=postgresql+asyncpg://copilot:copilot@postgres:5432/industrial_copilot

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=manual_chunks

# --- AI providers ---
# Required. Powers RAG generation, vision analysis, and later the diagnosis
# agent loop.
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001

# Optional. Only needed if VISION_PROVIDER=openai.
OPENAI_VISION_MODEL=gpt-4o-mini
VISION_PROVIDER=anthropic
VISION_API_KEY=

# --- Image analysis ---
MAX_IMAGE_SIZE_BYTES=15728640
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp
IMAGE_MAX_DIMENSION_PX=1568

# Chat-completion provider for RAG generation / the diagnosis agent.
# "openai" also covers Ollama or any OpenAI-compatible server via LLM_BASE_URL
# (e.g. http://host.docker.internal:11434/v1 for a local Ollama instance) —
# no paid key required if you point it at a local model.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=
LLM_BASE_URL=
OPENAI_API_KEY=

# Local embedding + reranking models (no API key required).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval tuning ---
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_TOP_K=5
MIN_RELEVANCE_SCORE=-100.0

# --- Diagnosis behavior ---
CONFIDENCE_APPROVAL_THRESHOLD=0.75
DIAGNOSIS_TIMEOUT_SECONDS=5

# --- Redis / Celery (document ingestion runs async on the worker) ---
REDIS_URL=redis://redis:6379/0

# --- Document ingestion ---
DATA_DIR=data
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf
OCR_PAGE_TEXT_THRESHOLD=20
CHUNK_TARGET_CHARS=1000
CHUNK_OVERLAP_CHARS=150

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=60/minute
