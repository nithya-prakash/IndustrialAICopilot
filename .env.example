# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Postgres ---
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=industrial_copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full async DSN used by the app; compose from the vars above by default.
DATABASE_URL=postgresql+asyncpg://copilot:copilot@postgres:5432/industrial_copilot

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=manual_chunks

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=60/minute
